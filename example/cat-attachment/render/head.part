<!doctype html>
<html><head><meta charset="utf-8">
<style>html,body{margin:0;background:#000}canvas{display:block}</style>
</head><body>
<canvas id="c" width="1920" height="1080"></canvas>
<script>
const W = 1280, H = 720, K = 1.5;
const c = document.getElementById('c'), g = c.getContext('2d');
const clamp = (x, a = 0, b = 1) => Math.max(a, Math.min(b, x));
const lerp = (a, b, k) => a + (b - a) * k;
const easeOut = x => 1 - Math.pow(1 - clamp(x), 3);
const ease = x => { x = clamp(x); return x < .5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2; };
const seg = (t, a, b) => clamp((t - a) / (b - a));
const SANS = '"Microsoft YaHei", "Noto Sans CJK SC", sans-serif';
const BG = '#FFF4E2', INK = '#2A2633', RED = '#E5484D', GREEN = '#1F9D63', BLUE = '#2D6CDF', GOLD = '#E89A12', MUTED = '#7D7488';
const FLOOR = '#EBD3B0', FLOOR2 = '#DDBF95';
const OR = '#F29A4A', OR2 = '#D97A2E', CREAM = '#FFE9CF', PINK = '#F08A9A';

function txt(parts, x, y, size, alpha = 1, weight = 800, align = 'center', shadow = 0) {
  if (alpha <= 0) return; g.save(); g.globalAlpha *= alpha; g.font = `${weight} ${size}px ${SANS}`;
  const w = parts.reduce((s, [s1]) => s + g.measureText(s1).width, 0);
  let cx = align === 'center' ? x - w / 2 : align === 'right' ? x - w : x; g.textAlign = 'left'; g.textBaseline = 'middle';
  if (shadow) { g.shadowColor = 'rgba(0,0,0,0.35)'; g.shadowBlur = shadow; }
  for (const [s1, col] of parts) { g.fillStyle = col; g.fillText(s1, cx, y); cx += g.measureText(s1).width; }
  g.restore();
}
function rr(x, y, w, h, r) { g.beginPath(); g.roundRect(x, y, w, h, r); }
function source(s, a) { txt([[s, 'rgba(42,38,51,0.55)']], 24, 616, 17, a, 500, 'left'); }
const pop = (t, t0, k = 0.5, d = 9) => t >= t0 ? 1 + k * Math.exp(-(t - t0) * d) : 1;

// ———— 橘猫（侧坐，面朝右）。原点 = 落地点 ————
// o: hx/hy 头的偏移, eye: 0 正常 1 睁大, crouch: 0～1 伏低, a: 透明度
function cat(x, y, s, o = {}) {
  const { hx = 0, hy = 0, eye = 0, crouch = 0, a = 1, tail = 0, wh = 0, glow = 0, fwd = 0, leg = 0, flip = 0, tongue = 0 } = o;
  g.save(); g.globalAlpha *= a; g.translate(x, y); g.scale(flip ? -s : s, s);
  // 尾巴
  g.strokeStyle = OR2; g.lineWidth = 26; g.lineCap = 'round';
  g.beginPath(); g.moveTo(-80, -18); g.bezierCurveTo(-170, -10, -175 + tail * 10, -90, -128 + tail * 18, -132); g.stroke();
  // 身体
  g.save(); g.translate(0, crouch * 30); g.scale(1 + crouch * 0.15, 1 - crouch * 0.25);
  g.fillStyle = OR; g.beginPath(); g.ellipse(-20, -92, 88, 96, 0, 0, 7); g.fill();
  g.strokeStyle = OR2; g.lineWidth = 10; for (let i = 0; i < 3; i++) { g.beginPath(); g.arc(-40 - i * 26, -120 + i * 8, 40, Math.PI * 1.15, Math.PI * 1.45); g.stroke(); }
  g.fillStyle = CREAM; g.beginPath(); g.ellipse(38, -96, 36, 62, 0.1, 0, 7); g.fill();
  g.restore();
  // 前腿
  g.fillStyle = OR; rr(12, -70, 30, 72, 14); g.fill(); rr(46, -70, 30, 72, 14); g.fill();
  g.fillStyle = CREAM; rr(10, -14, 34, 16, 8); g.fill(); rr(44, -14, 34, 16, 8); g.fill();
  if (leg > 0) { g.strokeStyle = `rgba(42,38,51,${0.35 + 0.6 * leg})`; g.lineWidth = 2 + leg * 1.5; for (let i = 0; i < 5; i++) { g.beginPath(); g.moveTo(13, -30 + i * 3); g.lineTo(13 - 14 - leg * 10, -42 + i * 5); g.stroke(); } }
  // 头
  g.save(); g.translate(56 + hx, -200 + hy + crouch * 60);
  g.fillStyle = OR; g.beginPath(); g.moveTo(-58, -30); g.lineTo(-48, -92); g.lineTo(-10, -58); g.fill();
  g.beginPath(); g.moveTo(58, -30); g.lineTo(48, -92); g.lineTo(10, -58); g.fill();
  g.fillStyle = PINK; g.beginPath(); g.moveTo(-46, -44); g.lineTo(-44, -76); g.lineTo(-22, -56); g.fill();
  g.beginPath(); g.moveTo(46, -44); g.lineTo(44, -76); g.lineTo(22, -56); g.fill();
  g.fillStyle = OR; g.beginPath(); g.ellipse(0, 0, 72, 64, 0, 0, 7); g.fill();
  g.strokeStyle = OR2; g.lineWidth = 8; g.lineCap = 'round';
  for (const dx of [-18, 0, 18]) { g.beginPath(); g.moveTo(dx, -60); g.lineTo(dx * 0.8, -38); g.stroke(); }
  g.fillStyle = CREAM; g.beginPath(); g.ellipse(14, 26, 40, 28, 0, 0, 7); g.fill();
  // 眼睛
  const er = 11 + eye * 5;
  for (const ex of [-14, 36]) { g.fillStyle = '#2A2633'; g.beginPath(); g.ellipse(ex, -4, er, er * 1.2, 0, 0, 7); g.fill();
    g.fillStyle = '#fff'; g.beginPath(); g.arc(ex + 4, -9, er * 0.35, 0, 7); g.fill(); }
  g.fillStyle = PINK; g.beginPath(); g.moveTo(14, 18); g.lineTo(26, 18); g.lineTo(20, 26); g.fill();
  g.strokeStyle = INK; g.lineWidth = 3; g.beginPath(); g.moveTo(20, 26); g.quadraticCurveTo(14, 36, 6, 32); g.moveTo(20, 26); g.quadraticCurveTo(26, 36, 34, 32); g.stroke();
  if (tongue > 0) { g.fillStyle = '#E85D75'; g.beginPath(); g.ellipse(22, 36 + tongue * 6, 7, 4 + tongue * 6, 0, 0, 7); g.fill(); }
  g.strokeStyle = 'rgba(42,38,51,0.6)'; g.lineWidth = 2.5;
  for (const k of [-1, 0, 1]) { const a0 = -0.12 + k * 0.28, a1 = 0.55 + k * 0.62, aa = lerp(a0, a1, fwd), L = 62 + fwd * 34;
    g.strokeStyle = fwd > 0.05 ? `rgba(42,38,51,${0.6 + 0.3 * fwd})` : 'rgba(42,38,51,0.6)'; g.lineWidth = 2.5 + fwd * 1.5;
    g.beginPath(); g.moveTo(50, 24 + k * 8); g.quadraticCurveTo(50 + Math.cos(aa) * L * 0.6, 24 + k * 8 + Math.sin(aa) * L * 0.4, 50 + Math.cos(aa) * L, 24 + k * 8 + Math.sin(aa) * L - wh * (14 + k * 6)); g.stroke(); }
  if (glow > 0) for (const ex of [-14, 36]) { const gr = g.createRadialGradient(ex, -4, 0, ex, -4, 30); gr.addColorStop(0, `rgba(190,255,120,${glow})`); gr.addColorStop(1, 'rgba(190,255,120,0)'); g.fillStyle = gr; g.beginPath(); g.arc(ex, -4, 30, 0, 7); g.fill(); }
  g.restore();
  g.restore();
}
const catNose = (x, y, s, hx = 0, hy = 0) => [x + s * (56 + hx + 20), y + s * (-200 + hy + 22)];

// ———— 小鱼干 ————
function treat(x, y, s, blur = 0, a = 1) {
  g.save(); g.globalAlpha *= a; if (blur > 0.3) g.filter = `blur(${blur}px)`;
  g.translate(x, y); g.scale(s, s);
  g.fillStyle = '#C9803F'; g.beginPath(); g.ellipse(0, 0, 46, 20, 0, 0, 7); g.fill();
  g.beginPath(); g.moveTo(36, 0); g.lineTo(70, -22); g.lineTo(64, 0); g.lineTo(70, 22); g.fill();
  g.strokeStyle = '#9E5D27'; g.lineWidth = 4;
  for (const dx of [-14, 2, 18]) { g.beginPath(); g.moveTo(dx - 8, -12); g.lineTo(dx + 6, 0); g.lineTo(dx - 8, 12); g.stroke(); }
  g.fillStyle = '#2A2633'; g.beginPath(); g.arc(-28, -4, 5, 0, 7); g.fill();
  g.fillStyle = '#fff'; g.beginPath(); g.arc(-26, -6, 2, 0, 7); g.fill();
  g.restore();
}

function floorScene(win = true) {
  g.fillStyle = FLOOR; g.fillRect(0, 520, W, 200);
  g.strokeStyle = FLOOR2; g.lineWidth = 3; for (let i = 0; i < 8; i++) { g.beginPath(); g.moveTo(i * 190 - 40, 520); g.lineTo(i * 190 - 120, 720); g.stroke(); }
  g.fillStyle = '#E2C6A0'; g.fillRect(0, 512, W, 10);
  // 墙上的窗
  if (win) { g.fillStyle = "#DDEFFB"; rr(900, 110, 240, 190, 16); g.fill(); g.strokeStyle = '#FFFFFF'; g.lineWidth = 10; g.stroke();
  g.beginPath(); g.moveTo(1020, 110); g.lineTo(1020, 300); g.moveTo(900, 205); g.lineTo(1140, 205); g.stroke(); }
}

function qmark(x, y, t0, t, a = 1) {
  if (t < t0) return; const k = easeOut(seg(t, t0, t0 + 0.2)), bob = Math.sin((t - t0) * 5) * 4;
  txt([['?', BLUE]], x, y - 20 * k + bob, 54 * (0.6 + 0.4 * k), a * k, 900);
}

function stamp(x, y, s, a, word, col = RED) {
  if (a <= 0) return; g.save(); g.globalAlpha *= a; g.translate(x, y); g.rotate(-0.12); g.scale(s, s);
  g.font = `900 92px ${SANS}`; const w = g.measureText(word).width;
  g.lineWidth = 10; g.strokeStyle = col; rr(-w / 2 - 36, -70, w + 72, 140, 18); g.stroke();
  g.fillStyle = col; g.textAlign = 'center'; g.textBaseline = 'middle'; g.fillText(word, 0, 6);
  g.restore();
}